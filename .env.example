# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Required signing and verification secret (at least 32 random bytes).
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# ALLOWED_ORIGINS: Kommagetrennte Whitelist erlaubter CORS-Origins.
# Wird zur Laufzeit vom Server eingelesen. Ist die Variable leer/nicht gesetzt,
# gilt der Entwicklungs-Fallback: http://localhost:3000,http://localhost:4200
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:4200"

# DATABASE_URL: PostgreSQL connection string used by Prisma for persistence.
# The application state (organizations, users, time entries, audit logs, ...) is
# stored in PostgreSQL. Required in all environments.
DATABASE_URL="postgresql://user:password@localhost:5432/timetracking_prod"

# LOG_FILE: Optional absolute path for server console output. Defaults to
# <working-directory>/logs/app.log (for example, /opt/timetracking/logs/app.log).
LOG_FILE=

# azure comm serv strings.
COMMUNICATION_SERVICES_CONNECTION_STRING=

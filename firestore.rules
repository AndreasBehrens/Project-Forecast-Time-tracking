rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: is Authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Server backend / API service bypass or admin access
    match /{document=**} {
      allow read, write: if true; // Allow backend API server and clients to sync
    }
  }
}
